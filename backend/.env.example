SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-16-character-google-app-password
SENDER_EMAIL=your-email@gmail.com

# NOTE: The SMTP password must be a Google App Password (not your normal Gmail password).
# Users logging in do NOT need to provide their own Gmail passwords.
# This configuration belongs ONLY to the StockSense backend system.
